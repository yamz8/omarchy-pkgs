pkgname=dicolens
pkgver=0.6.0
pkgrel=1
pkgdesc='Look through DICOM scans: CT, MR, X-ray, ultrasound, and hospital CDs'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/dicolens'
license=('MIT')
options=('!debug')
depends=('ffmpeg' 'hicolor-icon-theme' 'libarchive' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal' 'xdg-utils' 'zlib')
makedepends=('cmake' 'gcc' 'make')
# The window test draws text, and the CI container has no fonts until one is listed.
checkdepends=('ttf-dejavu')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('01fb8f53f1cbbe9fbe8542eadc7d452fe201340ca5a8500ded91232e11e0fb9d')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
